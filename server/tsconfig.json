{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",

    // Loose on purpose: this is a straight port (etap 10 — "czysty port
    // typów"), not a rewrite. better-sqlite3 row shapes stay untyped rather
    // than adding an interface per prepared statement for no correctness gain.
    "strict": false,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
